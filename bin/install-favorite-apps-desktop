#!/usr/bin/env python3
"""Install this user's manual Favorite Apps menu entry after wb-apps is installed."""
import argparse
import os
from pathlib import Path
import shlex
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--executable', type=Path, required=True,
                        help='Absolute path to the installed wb-apps executable')
    args = parser.parse_args()
    executable = args.executable.expanduser()
    if not executable.is_absolute() or not executable.is_file() or not os.access(executable, os.X_OK):
        parser.error('Install wb-apps first and pass its absolute executable path')
    root = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share')) / 'applications'
    root.mkdir(parents=True, exist_ok=True)
    target = root / 'starforge-favorite-apps.desktop'
    content = ('[Desktop Entry]\nType=Application\nName=Favorite Apps\n'
               'Comment=Review and open your favorite apps\n'
               'Exec=' + shlex.quote(str(executable)) + ' gui\n'
               'Icon=view-app-grid-symbolic\nTerminal=false\n'
               'Categories=Utility;\nStartupNotify=true\n')
    if target.exists() and (target.is_symlink() or target.read_text() != content):
        parser.error(f'{target} already contains another launcher; inspect it before changing it')
    if not target.exists():
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
    print(target)


if __name__ == '__main__':
    main()
