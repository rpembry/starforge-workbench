[Unit]
Description=Cloudflare Tunnel for personal AI Workbench
After=network-online.target workbench.service
Wants=network-online.target

[Service]
Type=simple
User=workbench-tunnel
Group=workbench-tunnel
LoadCredential=tunnel-token:/etc/workbench/tunnel-token
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file ${CREDENTIALS_DIRECTORY}/tunnel-token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
