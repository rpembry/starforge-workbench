# Default deny: publish only intentional source categories.
*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/AGENTS.md
!/pyproject.toml
!/uv.lock
!/src/
!/src/**/
!/src/**/*.py
!/src/**/*.sql
!/src/**/*.html
!/src/**/*.js
!/src/**/htmx-LICENSE.txt
!/bin/
!/bin/ai-workbench
!/config/
!/config/workbench.example.yaml
!/config/settings.example.yaml
!/config/opencode-attention.example.js
!/config/tmux.conf
!/schemas/
!/schemas/*.json
!/tests/
!/tests/*.py
!/tests/*.sh
!/tests/*.cjs
!/docs/
!/docs/*.md
!/deploy/
!/deploy/*.py
!/deploy/*.sh
!/deploy/*.service
!/deploy/runtime-downloads.json
!/deploy/service.env.example

# Sensitive and generated exclusions remain last.
.env
.env.*
*.pem
*.key
*.p12
*.sqlite*
*.db
*.tfstate*
*.jsonl
*.log
*.zip
*.tar*
credentials*
secrets*
auth.json
session*.json
state*.json
__pycache__/
.venv/
node_modules/
config/workbench.yaml
