# Default deny: publish only intentional source categories.
*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/AGENTS.md
!/pyproject.toml
!/uv.lock
!/src/
!/src/**/
!/src/**/*.py
!/src/**/*.sql
!/src/**/*.html
!/src/**/*.js
!/src/workbench/static/workbench-logo.png
!/src/**/htmx-LICENSE.txt
!/bin/
!/bin/ai-workbench
!/bin/aiw
!/bin/chrome
!/bin/keep-collector.mjs
!/config/
!/config/workbench.example.yaml
!/config/browser-workspaces.example.yaml
!/config/settings.example.yaml
!/config/execution.*.example.yaml
!/config/opencode-attention.example.js
!/config/tmux.conf
!/schemas/
!/schemas/*.json
!/tests/
!/tests/*.py
!/tests/*.sh
!/tests/*.cjs
!/tests/keep_collector.test.mjs
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/starforge-dashboard-simulated.png
!/deploy/
!/deploy/*.py
!/deploy/*.sh
!/deploy/*.service
!/deploy/workbench-collector-without-opencode.conf.example
!/deploy/runtime-downloads.json
!/deploy/service.env.example
!/deploy/instruction-worker.example.json

# Sensitive and generated exclusions remain last.
.env
.env.*
*.pem
*.key
*.p12
*.sqlite*
*.db
*.tfstate*
*.jsonl
*.log
*.zip
*.tar*
credentials*
secrets*
auth.json
session*.json
state*.json
__pycache__/
.venv/
node_modules/
config/workbench.yaml

# Sanitized, explicitly reviewed Docker evaluation evidence only.
!/docs/evaluations/
!/docs/evaluations/docker-workers-54.json
!/docs/evaluations/docker-workers-54-matched.json
!/docs/evaluations/docker-workers-54-matched-failed.json
!/docs/evaluations/docker-workers-54-reviewed.json
!/docs/evaluations/docker-workers-54-disposition.json
